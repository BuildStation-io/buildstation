# Existing Clerk + Convex integration. Use development credentials locally.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CONVEX_URL=
# Convex deployment configuration (set the issuer in the Convex dashboard).
CLERK_JWT_ISSUER_DOMAIN=

# Optional Luma calendar. Never prefix the API key with NEXT_PUBLIC_.
LUMA_CALENDAR_ID=
LUMA_CALENDAR_URL=
LUMA_API_KEY=
